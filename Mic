6) descending order 

code segment
assume cs:code

start:
mov ch,09h

back2:
mov si,2000h
mov cl,09h

back1:
mov al,[si]
mov ah,[si+1]
cmp al,ah

jbe skip
mov [si+1],al
mov [si],ah

skip:
inc si
dec cl
jnz back1

dec ch
jnz back2

int 3

code ends
end start

